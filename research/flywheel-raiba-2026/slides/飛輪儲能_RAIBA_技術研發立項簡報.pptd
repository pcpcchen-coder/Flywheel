version: v2
title: 飛輪儲能 × RAIBA 可重構電池系統技術研發立項簡報
size:
- 960
- 540
customFonts:
- family: MiSans
  src: https://statics.kimi.ai/neo-design-static/p-font/MiSans.ttf
- family: Liter
  src: https://statics.kimi.ai/neo-design-static/p-font/Liter.ttf
theme:
  colors:
    paper: '#F7F4ED'
    ink: '#22302E'
    teal: '#183F3B'
    teal2: '#245C57'
    copper: '#B65D38'
    gray: '#6B756F'
    line: '#D8D2C5'
    pale: '#E7ECE7'
    white: '#FFFFFF'
    soft: '#EEE8DC'
  textStyles:
    title:
      fontSize: 28
      color: $teal
      bold: true
      fontFamily:
        latin: Liter
        ea: MiSans
    body:
      fontSize: 18
      color: $ink
      fontFamily:
        latin: Liter
        ea: MiSans
      lineHeight: 1.25
    note:
      fontSize: 10
      color: $gray
      fontFamily:
        latin: Liter
        ea: MiSans
  tableStyles: {}
